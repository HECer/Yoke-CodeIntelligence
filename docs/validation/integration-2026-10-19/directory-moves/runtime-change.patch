+fn fixture(epoch: AnalyzerEpoch) -> Fixture {
+    let root = tempfile::tempdir().unwrap();
+    fs::create_dir_all(root.path().join("src/tree/sub")).unwrap();
+    fs::create_dir_all(root.path().join("src/tree/empty/nested")).unwrap();
