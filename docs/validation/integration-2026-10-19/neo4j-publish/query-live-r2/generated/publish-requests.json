93f63e2c68e63aae7a2199a8c626c75691cd","scopeKey":"40db02c94e3995218065f2e26c99b17b5ce2d62a102718b9278fee02de61427f","unresolved":[{"key":"96ddd5337d5456014e91b511ae8a73ff29dad8b35c5f8e9a22e212f08d039f53","props":{"category":"unresolved","label":"missing","observationId":"7c72b2a39d929bdd71286836248c0d534315fa04c7314d662e8a5cd68b820ced","revisionId":"734ac4620d5be838e0826113440b93f63e2c68e63aae7a2199a8c626c75691cd","rowJson":"{\"observationId\":\"7c72b2a39d929bdd71286836248c0d534315fa04c7314d662e8a5cd68b820ced\",\"sourceTargetWasNull\":true,\"targetLabel\":\"missing\"}","scopeKey":"40db02c94e3995218065f2e26c99b17b5ce2d62a102718b9278fee02de61427f","sourceTargetWasNull":true},"rowHash":"7fbaec66ecf24c1ecb467e7cc82a247efcd3ee9c5ea288b05e2e020a75d71361"}]},"statement":"CYPHER 5 MATCH (scope:YokeNativeScope {key:$scopeKey}) WITH scope LIMIT 2 WITH collect(scope) AS scopes WHERE size(scopes)=1 UNWIND scopes AS scope SET scope.lockCounter=coalesce(scope.lockCounter,0)+1 WITH scope FOREACH (deny IN CASE WHEN scope.ownerKind='yoke-native-neo4j-v1' AND scope.schemaVersion=1 AND (scope.activeRevision=$expectedRevision OR scope.activeRevision=$revisionId) THEN [] ELSE [1] END | CREATE (:YokeNativeScope {key:$scopeKey})) FOREACH (row IN $entities | MERGE (n:YokeNativeElement:YokeNativeEntity {key:row.key}) ON CREATE SET n += row.props,n.rowHash=row.rowHash FOREACH (deny IN CASE WHEN n.rowHash=row.rowHash AND all(k IN keys(row.props) WHERE n[k]=row.props[k]) THEN [] ELSE [1] END | CREATE (:YokeNativeScope {key:$scopeKey}))) FOREACH (row IN $evidence | MERGE (n:YokeNativeElement:YokeNativeEvidence {key:row.key}) ON CREATE SET n += row.props,n.rowHash=row.rowHash FOREACH (deny IN CASE WHEN n.rowHash=row.rowHash AND all(k IN keys(row.props) WHERE n[k]=row.props[k]) THEN [] ELSE [1] END | CREATE (:YokeNativeScope {key:$scopeKey}))) FOREACH (row IN $unresolved | MERGE (n:YokeNativeElement:YokeNativeUnresolved {key:row.key}) ON CREATE SET n += row.props,n.rowHash=row.rowHash FOREACH (deny IN CASE WHEN n.rowHash=row.rowHash AND all(k IN keys(row.props) WHERE n[k]=row.props[k]) THEN [] ELSE [1] END | CREATE (:YokeNativeScope {key:$scopeKey}))) FOREACH (row IN [$revision] | MERGE (n:YokeNativeElement:YokeNativeRevision {key:row.key}) ON CREATE SET n += row.props,n.rowHash=row.rowHash FOREACH (deny IN CASE WHEN n.rowHash=row.rowHash AND all(k IN keys(row.props) WHERE n[k]=row.props[k]) THEN [] ELSE [1] END | CREATE (:YokeNativeScope {key:$scopeKey}))) FOREACH (row IN $observations | MERGE (src:YokeNativeElement {key:row.sourceKey}) MERGE (dst:YokeNativeElement {key:row.targetKey}) MERGE (src)-[r:YOKE_NATIVE_OBSERVATION {key:row.key}]->(dst) ON CREATE SET r += row.props,r.rowHash=row.rowHash FOREACH (deny IN CASE WHEN r.rowHash=row.rowHash AND all(k IN keys(row.props) WHERE r[k]=row.props[k]) THEN [] ELSE [1] END | CREATE (:YokeNativeScope {key:$scopeKey}))) SET scope.activeRevision=$revisionId,scope.activeRevisionKey=$revision.key RETURN {scopeKey:scope.key,revisionId:scope.activeRevision,payloadHash:$payloadHash,planId:$planId,entityCount:size($entities),observationCount:size($observations),evidenceCount:size($evidence),unresolvedCount:size($unresolved)} AS receipt"}]