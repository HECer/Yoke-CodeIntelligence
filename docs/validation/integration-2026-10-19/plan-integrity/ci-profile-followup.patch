diff --git a/.github/workflows/rust.yml b/.github/workflows/rust.yml
index 581ea9c..3f8d109 100644
--- a/.github/workflows/rust.yml
+++ b/.github/workflows/rust.yml
@@ -43,7 +43,14 @@ jobs:
       - run: python -m unittest discover -s scripts/tests -v
       - run: cargo fmt --all --check
       - run: cargo clippy --workspace --all-targets --locked --keep-going -j 2 -- -D warnings
-      - run: cargo test --workspace --locked --no-fail-fast -j 2 -- --test-threads=2
+      # Independent Windows fixtures share ancestors protected against write/delete opens.
+      # Concurrency adversaries inside each test keep their original threads and assertions.
+      - name: Test native Windows protected namespaces
+        if: runner.os == 'Windows'
+        run: cargo test --workspace --locked --no-fail-fast -j 2 -- --test-threads=1
+      - name: Test native Unix targets
+        if: runner.os != 'Windows'
+        run: cargo test --workspace --locked --no-fail-fast -j 2 -- --test-threads=2
       - run: cargo test --locked --test live actual_rust_analyzer -- --ignored
       - run: cargo build --workspace --release --locked
       - uses: actions/upload-artifact@v4
